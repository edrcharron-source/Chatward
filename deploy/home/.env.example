# Chatward home server settings. install.sh copies this to .env (mode 600) and fills in the random keys.
# Public name friends type into the app. Needs a DNS-only (grey cloud) A record on Cloudflare; ddns-update.sh keeps it current.
DOMAIN=chat.lebserver.com
# The box's LAN address. Caddy listens on 443 here only; the router forwards 443 to it. Make it a fixed IP in UniFi.
LAN_IP=192.168.1.228
# Cloudflare API token with Zone > DNS > Edit and Zone > Zone > Read, on lebserver.com only. Used for the certificate and for dynamic DNS.
CF_API_TOKEN=
# Optional: email for Let's Encrypt expiry notices, written as: email you@example.com
ACME_EMAIL=
# Voice/video keys. install.sh fills these with random values. The secret must be 32+ characters.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Code the first account must enter on the Register screen. install.sh fills it in and prints it.
SETUP_CODE=
# Where data lives on the host. Database on the NVMe, uploads and backups on the RAID.
DATA_PATH=/srv/chatward/data
UPDATES_PATH=/srv/chatward/updates
UPLOADS_PATH=/mnt/storage/chatward/uploads
BACKUP_PATH=/mnt/storage/chatward/backups
# Optional: free API key from klipy.com so the GIF picker works.
KLIPY_API_KEY=
# Optional: upload space each person may keep, in MB (default 5120). 0 = no limit.
# UPLOAD_QUOTA_MB=5120
# Optional: clients older than this version are blocked until they update, e.g. 0.2.0.
# MIN_CLIENT_VERSION=
