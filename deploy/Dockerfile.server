FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/server packages/server
RUN npm ci -w @chatward/shared -w @chatward/server --include-workspace-root=false \
 && npm run build -w @chatward/shared && npm run build -w @chatward/server

# The web app (browsers and the iPhone home-screen app): the desktop app's page built for the browser. Electron itself
# is never downloaded; only the page's build tools are needed.
FROM node:22-bookworm-slim AS web
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ARG CHATWARD_COMMIT=unknown
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/client packages/client
RUN npm ci -w @chatward/shared -w @chatward/client --include-workspace-root=false --ignore-scripts \
 && npm run build -w @chatward/shared && CHATWARD_COMMIT=$CHATWARD_COMMIT npm run build:web -w @chatward/client

# The Vault photo sorter's image model (MobileCLIP S0, 45 MB). Clients download it from this server and sort on their
# own devices. Checked against a fixed hash; if the download fails the build carries on and clients sort by clues only.
FROM node:22-bookworm-slim AS models
ARG SORT_MODEL_URL=https://huggingface.co/Xenova/mobileclip_s0/resolve/main/onnx/vision_model.onnx
ARG SORT_MODEL_SHA256=17d3c037b1d488c10c50e09f6009ea5a198caef4e0e8f4ea5617b7cb2d067ac0
RUN mkdir -p /models && node -e "\
  fetch(process.env.SORT_MODEL_URL).then(async (r) => { \
    if (!r.ok) throw new Error('HTTP ' + r.status); \
    const b = Buffer.from(await r.arrayBuffer()); \
    const h = require('crypto').createHash('sha256').update(b).digest('hex'); \
    if (h !== process.env.SORT_MODEL_SHA256) throw new Error('unexpected hash ' + h); \
    require('fs').writeFileSync('/models/mobileclip_s0_vision.onnx', b); \
  }).catch((e) => console.error('Vault sorter model not downloaded, clients will sort by clues only:', e.message));"

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production CHATWARD_WEB_DIR=/app/web
COPY --from=build /app ./
COPY --from=web /app/packages/client/out/web ./web
COPY --from=models /models ./models
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "packages/server/dist/index.js"]
