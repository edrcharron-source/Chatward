FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/server packages/server
RUN npm ci -w @chatward/shared -w @chatward/server --include-workspace-root=false \
 && npm run build -w @chatward/shared && npm run build -w @chatward/server

# The web app (browsers and the iPhone home-screen app): the desktop app's page built for the browser. Electron itself
# is never downloaded; only the page's build tools are needed.
FROM node:22-bookworm-slim AS web
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ARG CHATWARD_COMMIT=unknown
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/client packages/client
RUN npm ci -w @chatward/shared -w @chatward/client --include-workspace-root=false --ignore-scripts \
 && npm run build -w @chatward/shared && CHATWARD_COMMIT=$CHATWARD_COMMIT npm run build:web -w @chatward/client

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production CHATWARD_WEB_DIR=/app/web
COPY --from=build /app ./
COPY --from=web /app/packages/client/out/web ./web
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "packages/server/dist/index.js"]
