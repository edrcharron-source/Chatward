# Optional: free API key from klipy.com so the GIF picker works.
KLIPY_API_KEY=
# Optional: clients older than this version are blocked until they update, e.g. 0.2.0.
# MIN_CLIENT_VERSION=
# Voice on a cloud server: the address friends' apps use to reach LiveKit, e.g. ws://YOUR-SERVER-PUBLIC-IP:7880.
# Leave unset when only this PC uses the server.
# LIVEKIT_URL=
