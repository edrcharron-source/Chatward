# Voice/video keys. Leave these blank: start-server.bat fills them with random values on first run.
# On a Linux server, set them yourself (see docs/UPDATES.md). The server refuses to start with the old defaults.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: free API key from klipy.com so the GIF picker works.
KLIPY_API_KEY=
# Optional: clients older than this version are blocked until they update, e.g. 0.2.0.
# MIN_CLIENT_VERSION=
