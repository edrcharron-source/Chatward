{
  "name": "@chatward/client",
  "productName": "Chatward",
  "version": "0.1.0",
  "description": "Private, end-to-end encrypted chat for friends",
  "author": "Chatward",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "electron-vite build && electron-builder --win nsis portable --publish never",
    "test:crypto": "esbuild src/renderer/src/crypto/crypto.test.ts src/renderer/src/crypto/mls.test.ts --bundle --platform=node --format=esm --outdir=out/test --out-extension:.js=.mjs --log-level=warning && node --test out/test/crypto.test.mjs out/test/mls.test.mjs",
    "test:fit": "esbuild src/renderer/src/state/fitPayload.test.ts --bundle --platform=node --format=esm --outfile=out/test/fitPayload.test.mjs --log-level=warning && node --test out/test/fitPayload.test.mjs",
    "test:demo": "esbuild src/renderer/src/demo/codec.test.ts --bundle --platform=node --format=esm --outfile=out/test/codec.test.mjs --log-level=warning && node --test out/test/codec.test.mjs",
    "test:policy": "esbuild src/main/serverPolicy.test.ts --bundle --platform=node --format=esm --outfile=out/test/policy.test.mjs --log-level=warning && node --test out/test/policy.test.mjs",
    "test:media": "esbuild src/renderer/src/components/media/safeUrls.test.ts --bundle --platform=node --format=esm --outfile=out/test/safeUrls.test.mjs --log-level=warning && node --test out/test/safeUrls.test.mjs",
    "test:e2e-client": "npm run build -w @chatward/server && esbuild test/e2e-client/device.ts --bundle --platform=node --format=esm --outfile=out/e2e-client/device.mjs --log-level=warning && esbuild test/e2e-client/run.ts --bundle --platform=node --format=esm --outfile=out/e2e-client/run.mjs --external:ts-mls --log-level=warning && node out/e2e-client/run.mjs"
  },
  "devDependencies": {
    "@chatward/shared": "*",
    "@noble/hashes": "2.4.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^44.10.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "emoji-picker-element": "^1.26.0",
    "emoji-picker-element-data": "^1.6.0",
    "livekit-client": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.0.8",
    "ts-mls": "1.6.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "app.chatward.client",
    "productName": "Chatward",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:3000/updates"
      }
    ],
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Chatward-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Chatward-Setup.exe"
    },
    "electronVersion": "44.10.0",
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  }
}
